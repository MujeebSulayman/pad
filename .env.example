# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.
# Also add every value to Vercel → Project → Settings → Environment Variables.

# ── Browser (NEXT_PUBLIC_, shipped to every visitor — no secrets) ──────────────

# Privy app for login + wallets (Solana and EVM). https://dashboard.privy.io
# Leave empty to run the simulated demo instead of real launches.
NEXT_PUBLIC_PRIVY_APP_ID=

# RPC endpoints (Alchemy: https://dashboard.alchemy.com). Lock the key to your domains in Alchemy,
# since it's visible in the browser.
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/<key>
# Defaults to the HTTP URL with wss://
NEXT_PUBLIC_SOLANA_WS_URL=
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
NEXT_PUBLIC_BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/<key>
# Robinhood Chain (chain id 4663 is built in). Empty → Robinhood real wallets are off.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>

# MirrorPad's fee wallets (public addresses). 2% of trades, withdrawals and own-contract supply goes here,
# plus MirrorPad's share of Clanker, Bags and Zora fees. Empty = that side's fees are off.
# Send the Solana treasury ~0.002 SOL once: an empty Solana account can't receive small fees.
NEXT_PUBLIC_TREASURY_SOLANA=
NEXT_PUBLIC_TREASURY_EVM=

# ── Server only (secrets) ─────────────────────────────────────────────────────

# Neon Postgres connection string (Neon console → Connect). The launches table is created on first use;
# db/schema.sql has the same DDL if you'd rather run it yourself.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# Optional. Privy's public verification key (PEM, newlines written as \n). Leave empty and the server
# fetches your app's keys from Privy automatically. This is not the app secret.
PRIVY_VERIFICATION_KEY=

# Pinata (https://app.pinata.cloud → API Keys → JWT) for pinning token images and metadata to IPFS.
PINATA_JWT=
# Optional dedicated gateway, e.g. https://<name>.mypinata.cloud (defaults to https://ipfs.io)
PINATA_GATEWAY=

# Venue API keys. A venue whose key is missing fails with a clear message; the others still work.
# Bags: https://dev.bags.fm
BAGS_API_KEY=
# Zora (optional, raises rate limits): https://zora.co/settings/developer
ZORA_API_KEY=
# In-app trading. Base / BNB Chain / Robinhood Chain trades go through 0x: https://dashboard.0x.org
ZEROX_API_KEY=
# Optional: Solana trades work without it at a lower rate limit. https://developers.jup.ag/portal
JUPITER_API_KEY=
